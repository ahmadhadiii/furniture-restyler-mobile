# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# vendor/augen is a vendored library package (see pubspec.yaml's
# dependency_override) - its own build output and lockfile are regenerated
# by running flutter test/pub get inside it and shouldn't be tracked, same
# reasoning as the app's own /build/ above. A library's pubspec.lock isn't
# meant to be committed either (only apps pin exact transitive versions).
vendor/**/build/
vendor/**/pubspec.lock
vendor/**/.dart_tool/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
